# Copy to .env (untracked) and point these at your local copies.
# Raw H&E WSIs, registered adjacent sections and CyCIF data (Zenodo: https://zenodo.org/records/21299341).
FMSAE_RAW_DATA=/path/to/raw_data
# Earlier analysis outputs read by a few legacy scripts/notebooks (optional).
FMSAE_LEGACY_ANALYSIS=/path/to/analysis_meson
